# ──────────────────────────────────────────────
# Spectra — Environment Variables Setup Example
# ──────────────────────────────────────────────

# ── Base Currency ────────────────────────────
# The base currency used for all output and budgets.
# Use standard 3-letter ISO 4217 codes (e.g., EUR, USD, GBP, JPY, CAD)
# If a transaction is in a different currency, Spectra will use the
# free Frankfurter API to convert it to this currency using historical rates.
BASE_CURRENCY=EUR

# ── Google Sheets ────────────────────────────
# Google Sheets credentials are used only by the importer. For native runs you
# may point to a local service-account file. In Docker Compose, provide the
# base64 option because credentials are intentionally excluded from the image.
# GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
# Alternatively, provide the JSON content as a base64 string:
# GOOGLE_SHEETS_CREDENTIALS_B64=
# The ID of your Google Sheet (from its URL):
# SPREADSHEET_ID=your_google_sheet_id_here

# ── AI Provider ──────────────────────────────
# Choose 'local' (fully offline), 'openai', or 'gemini'.
AI_PROVIDER=local

# If using OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# If using Gemini (free tier available):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemma-3-27b-it

# Docker Compose binds only the gateway to loopback by default.
# SPECTRA_HOST=127.0.0.1
# SPECTRA_PORT=8080

# ── Developer Config ─────────────────────────
LOG_LEVEL=INFO
